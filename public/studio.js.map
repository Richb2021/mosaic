      "id": "community",
      "title": "The supper that almost wasn’t",
      "giver": "inn",
      "offer": "Maren has promised supper to the mill workers, but the kitchen and the courtyard garden share one delivery. She refuses to solve one problem by quietly passing it to a neighbour. “Would you help us make a fair plan?”",
      "done": "Maren puts your plan beside the kitchen door. The courtyard gets its share, the supper table is laid, and nobody has to guess what remains. “Tomorrow we will count first,” she says. The inn’s gathering table is now ready.",
      "reward": {
        "gold": 40,
        "xp": 12
      },
      "steps": [
        {
          "location": "millhouse",
          "target": "resident",
          "title": "Ask Rook at the millhouse",
          "text": "Rook checks the millhouse board. “Today’s delivery is twelve equal buckets. The kitchen needs eight for its planned jobs. The courtyard beds need four. We cannot promise more water than we actually have.”",
          "after": "You write the account in your quest journal. Follow the next lead at the Copper Oven."
        },
        {
          "location": "bakery",
          "target": "ledger",
          "title": "Examine the household ledger",
          "text": "Pell’s ledger confirms the same day and the same bucket size: kitchen, eight buckets; courtyard, four. A crossed-out draft promised ten to the kitchen and six to the garden. There were never sixteen buckets to share.",
          "after": "You now have both pieces of evidence. Return to the Amber Lantern supper table."
        },
        {
          "location": "inn",
          "target": "workbench",
          "title": "Prepare the household plan",
          "text": "You lay the notes beside each other. The neighbours are waiting for a plan they can use.",
          "after": "Eight plus four uses all twelve buckets. A plan for a shared resource must respect both the available total and the stated needs.",
          "challenge": {
            "type": "allocation",
            "prompt": "Set aside the twelve delivered buckets. Meet the kitchen’s eight-bucket plan and the garden’s four-bucket plan without creating or losing any.",
            "total": 12,
            "solution": 8,
            "labels": [
              "Kitchen",
              "Courtyard"
            ],
            "unit": "equal buckets",
            "hint": "The two allocations must add to twelve. The kitchen’s plan calls for eight.",
            "explanation": "Eight plus four uses all twelve buckets. A plan for a shared resource must respect both the available total and the stated needs."
          }
        },
        {
          "location": "inn",
          "target": "resident",
          "title": "Return to Maren",
          "text": "Your work is ready. Explain the plan and let the household put it into practice.",
          "after": "The neighbours can carry on."
        }
      ]
    },
