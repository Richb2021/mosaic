{
  "name": "mosaic-lanternbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs && node scripts/run-framework.mjs build",
    "dev": "node build.mjs && node scripts/run-framework.mjs dev --port 8878",
    "test": "node --test tests/*.test.mjs",
    "build:game": "node build.mjs",
    "db:generate": "drizzle-kit generate",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0"
  },
  "dependencies": {
    "@nocodebackend/account-react": "^0.1.9",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "@xmldom/xmldom": "0.9.12",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
